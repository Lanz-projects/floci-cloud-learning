# Terraform provider plugins and local cache
**/.terraform/

# Terraform state and saved plans (may contain sensitive values)
*.tfstate
*.tfstate.*
*.tfplan
*.plan
**/tfplan

# Local variable files may contain credentials or other secrets
*.tfvars
*.tfvars.json

# Terraform crash logs and local override files
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep .terraform.lock.hcl tracked to pin provider selections

# Local environment settings
.env
.env.*
!.env.example

# .NET build output and user-specific IDE files
**/bin/
**/obj/
**/TestResults/
**/.vs/
*.suo
*.user

# Files downloaded by the local S3 demo
**/downloaded/
